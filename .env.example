# ─────────────────────────────────────────────────────────────
# NoPlanB – Environment Configuration
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────

# ── Ollama / Local Gemma ──────────────────────────────────────
# URL of your locally running Ollama instance
OLLAMA_BASE_URL=http://localhost:11434/v1

# The model to use. Recommended: gemma3:4b or gemma3:12b
# Pull with: ollama pull gemma3:4b
GEMMA_MODEL=gemma3:4b

# ── Temporal ─────────────────────────────────────────────────
# Address of your local Temporal dev server
# Start with: temporal server start-dev
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=noplanb-queue

# ── Sentry (Agent Tracing) ───────────────────────────────────
# Get your DSN from https://sentry.io → Project → Settings → DSN
SENTRY_DSN=

# Set to 1 to send full prompt/response to Sentry (useful for debugging).
# Set to 0 in production to keep journal entries 100% private.
SENTRY_SEND_PII=0

# ── Vault ─────────────────────────────────────────────────────
# Root path of the Obsidian-compatible markdown vault.
# Default: ./vault  (relative to project root)
VAULT_ROOT=./vault

# ── API Server ────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000

# ── Notifications ─────────────────────────────────────────────
# Optional: Telegram bot token + your chat ID for task nudges.
# Leave empty to use local browser notifications only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
